# Qdrant Config
QDRANT_HOST=localhost
QDRANT_PORT=6333
MATCHING_COLLECTION=matching_store

DATA_DIR=data

CHALLENGES_GLOB=*challenges*.csv
SOLUTIONS_GLOB=*solutions*.csv

# Sentence-Transformers model for embedding generation
MODEL_NAME=all-MiniLM-L6-v2

# How many texts to embed in one call to the model
BATCH_SIZE=256

# Reserved point-id ranges so challenge and solution points never collide
# within the shared collection (both start their local index at 0).
CHALLENGE_ID_OFFSET=0
SOLUTION_ID_OFFSET=10000000

# How many challenge/solution points to batch per Qdrant offline-scoring call
SCORE_BATCH_SIZE=50


# Score band: only pairs within this cosine similarity range are considered
MIN_MATCH_SCORE=0.85
MAX_MATCH_SCORE=0.95

# Fallback score threshold: used per-challenge when the primary MIN_MATCH_SCORE
# returns zero solutions. The system retries with this lower threshold.
FALLBACK_MATCH_SCORE=0.70

# How many solutions to fetch per challenge during live pairing
TOP_SOLUTIONS_PER_CHALLENGE=50

# Which bot_type of solutions to fetch when pairing.
# Valid values:
#   story      – only solutions where bot_type = "story"
#   discussion – only solutions where bot_type = "discussion"
#   hybrid     – both types (no bot_type filter, current default behaviour)
SOLUTION_BOT_TYPE=hybrid

#Redis
CACHE_TTL_HOURS=2.0

# Rate limit per IP address (e.g., "10/minute", "5/second", "100/hour", "5/minute")
RATE_LIMIT=10/minute


# -----------------------------------------------------------------------------
# CORS / Origin Allowlist
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for the API.
# Use * to allow all origins (NOT recommended for production).
# Examples:
#   ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
#   ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Which HTTP methods are allowed through CORS
ALLOWED_METHODS=GET,POST,OPTIONS

# Which request headers are allowed through CORS
ALLOWED_HEADERS=Content-Type,Authorization

# -----------------------------------------------------------------------------
# Gemini LLM Integration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
PRE_LLM_FETCH_SIZE=40
