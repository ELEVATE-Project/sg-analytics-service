# QDRANT — Vector Database
QDRANT_HOST=localhost                          # Hostname where Qdrant is running
QDRANT_PORT=6333                               # Default Qdrant HTTP port
MATCHING_COLLECTION=matching_store             # Single collection holding both challenge & solution vectors


# INGEST — Data Ingestion Pipeline (scripts/ingest.py only) [This is specifically for Phase 1 Qdrant Data-Push]

# -- Source data paths --------------------------------------------------------
DATA_DIR=data                                  # Root folder where CSV input files are located
CHALLENGES_GLOB=*challenges*.csv               # Glob pattern to discover challenge CSV file(s)
SOLUTIONS_GLOB=*solutions*.csv                 # Glob pattern to discover solution CSV file(s)

# -- Embedding model ----------------------------------------------------------
MODEL_NAME=all-MiniLM-L6-v2                    # Sentence-Transformers model used to produce vectors
BATCH_SIZE=256                                 # Number of texts embedded per model call (tune to GPU/CPU RAM)
SCORE_BATCH_SIZE=50                            # How many points to fetch per Qdrant scroll page during scoring
SCORE_CANDIDATE_POOL_SIZE=50                   # Nearest neighbours inspected per point to find a valid (non-duplicate) match

# LOGGING — Application Log Settings
LOG_LEVEL=INFO                                 # Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs                                   # Directory for rotating daily log files (relative to project root)
LOG_RETENTION_DAYS=7                           # Number of daily log files to retain before the oldest is deleted
DEBUG_LOG_DIR=pre_llm_logs                     # Directory for pre-LLM debug dumps (logged before Gemini call)


# API — Runtime Behaviour
RATE_LIMIT=10/minute                           # Per-IP request rate limit (e.g. "10/minute", "5/second")
FINAL_RESULT_SIZE=20                           # Max challenge-solution pairs returned per API response
PRE_LLM_FETCH_SIZE=40                          # Candidate pairs fetched from Qdrant before LLM validation step
TOP_SOLUTIONS_PER_CHALLENGE=50                 # Legacy/debug view: top-N solutions shown per challenge

# -- Solution filtering -------------------------------------------------------
# Controls which bot_type of solutions are eligible during live pairing.
# Valid values:
#   story      – only solutions where bot_type = "story"
#   discussion – only solutions where bot_type = "discussion"
#   hybrid     – both types (no bot_type filter)
SOLUTION_BOT_TYPE=hybrid                       # story | discussion | hybrid (no filter)
SOLUTION_CANDIDATE_POOL_SIZE=50                # Nearest solution candidates inspected per challenge during live pairing
MAX_PER_TOPIC=1                                # Max solutions returned per topic to avoid clustering

# Only cosine-similarity scores within [MIN, MAX] are considered valid pairs.
MIN_MATCH_SCORE=0.85                           # Lower cosine-similarity bound for a valid match
MAX_MATCH_SCORE=0.95                           # Upper cosine-similarity bound (filters near-identical duplicates)
FALLBACK_MATCH_SCORE=0.70                      # Retry threshold when primary MIN_MATCH_SCORE yields zero results


# CACHE — Redis
REDIS_URL=redis://localhost:6379/0             # Redis connection URL (database 0)
CACHE_TTL_HOURS=2.0                            # How long cached results are kept (hours); resets on process restart


# CORS — Cross-Origin Resource Sharing
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET                      # HTTP methods permitted through CORS
ALLOWED_HEADERS=Content-Type,Authorization,X-API-Token # Request headers permitted through CORS


# AUTH — API Security
API_TOKEN=<REPLACE>                            # Strong random hex token — generate one, never reuse


# OPENROUTER — LLM Integration
OPENROUTER_API_KEY=<REPLACE>
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=90

# DATABASE — PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/de-name

# GCP — Google Cloud Platform
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json # Path to service-account key JSON (never commit this file)
GCP_BUCKET_NAME=<REPLACE>                      # GCS bucket where exports are uploaded
API_BASE_URL=http://localhost:8000             # Base URL the cron job calls when hitting the API
